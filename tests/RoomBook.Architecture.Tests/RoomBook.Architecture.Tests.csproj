<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The only project allowed to see every layer: the inspection rules need all three assemblies.
       The rules themselves exclude assemblies whose name ends in .Tests (FD-2 exclusion test). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\RoomBook.Domain\RoomBook.Domain.csproj" />
    <ProjectReference Include="..\..\src\RoomBook.Application\RoomBook.Application.csproj" />
    <ProjectReference Include="..\..\src\RoomBook.Api\RoomBook.Api.csproj" />
  </ItemGroup>

  <!-- The assembly that breaks every rule on purpose, so the rules can be proven on compiled code. -->
  <ItemGroup>
    <ProjectReference Include="..\RoomBook.Architecture.Fixtures\RoomBook.Architecture.Fixtures.csproj" />
    <ProjectReference Include="..\..\src\RoomBook.Infrastructure\RoomBook.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
